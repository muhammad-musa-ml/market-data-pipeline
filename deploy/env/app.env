# Defaults for every python service. These are local development values;
# the stack only listens on the compose network and 127.0.0.1.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=mdp
MYSQL_PASSWORD=mdp
MYSQL_DATABASE=market

KAFKA_BOOTSTRAP=kafka-1:9092,kafka-2:9092,kafka-3:9092
BARS_TOPIC=market.bars.v1
PROGRESS_TOPIC=market.producer-progress.v1
BARS_PARTITIONS=4

WEBHDFS_URL=http://namenode:9870
HDFS_USER=hadoop
HDFS_MIN_DATANODES=3

BACKFILL_ADDR=backfill:50051
